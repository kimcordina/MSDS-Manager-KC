<Window x:Class="MSDSManager.ReviewDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SDS Review &amp; Compliance Dashboard"
        Height="760"
        Width="1200"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Review &amp; supplier tracking"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding NeedsAttentionCount, StringFormat=Needs attention: {0}}"/>
                        </Border>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="{Binding VerificationDueCount, StringFormat=Verification due: {0}}"/>
                        </Border>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{Binding SupersededCount, StringFormat=Superseded: {0}}"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox Width="180"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Export register (CSV)"
                            Command="{Binding ExportRegisterCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrushSubtle}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.4*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.8*"/>
                    <DataGridTextColumn Header="Revision" Binding="{Binding RevisionDateDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="130"/>
                    <DataGridTextColumn Header="Supplier check" Binding="{Binding VerificationDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionHint}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="12,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding SelectedItem.ProductName}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedItem.FileName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="Supplier"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Save supplier"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveSupplierCommand}"/>
                            <Button Content="Mark verified today"
                                    Command="{Binding MarkVerifiedCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Request latest SDS"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RequestLatestSdsCommand}"/>
                            <Button Content="Open PDF"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenSelectedPdfCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="Version / review notes"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <TextBox Text="{Binding ChangeSummary}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFB"/>

                        <TextBlock Text="Recent activity"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Activity}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd MMM yyyy HH:mm}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding Detail}"
                                               TextWrapping="Wrap"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
