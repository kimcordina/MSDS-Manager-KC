<Window x:Class="MSDSManager.OutlookMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find requested SDS — Outlook"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Software proposes — you approve — Outlook attaches"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding OutlookHint}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding EmailSubject}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding EmailPreview}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="60"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LearnedAliasSummary}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Find from Outlook"
                                Command="{Binding FindFromOutlookCommand}"/>
                        <Button Content="Match pasted text"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MatchFromPasteCommand}"/>
                    </StackPanel>
                    <Button Content="Save approved aliases"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SaveApprovedAliasesCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            ToolTip="Remember the requested names for the ticked SDS files without attaching yet."/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Attach approved SDS to reply"
                        Command="{Binding AttachApprovedCommand}"
                        Padding="16,10"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Background="{StaticResource PanelBrush}"
                      BorderBrush="{StaticResource BorderBrushSubtle}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Attach"
                                            Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60"/>
                    <DataGridTextColumn Header="Requested product"
                                        Binding="{Binding RequestedTerm}"
                                        Width="1.4*"
                                        IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Matched SDS" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding CandidateDocuments}"
                                          SelectedItem="{Binding SelectedDocument, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="ProductName"
                                          IsEditable="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusLabel}"
                                        Width="130"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Confidence"
                                        Binding="{Binding ConfidenceLabel}"
                                        Width="110"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Alias"
                                        Binding="{Binding AliasHint}"
                                        Width="160"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1"
                       Text="Reply text (inserted above the quoted email — nothing is sent automatically)"
                       FontWeight="SemiBold"
                       Margin="0,12,0,6"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ReplyTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8"/>
                <DockPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Paste-email fallback (always available)"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="If Outlook is not running, nothing is selected, or the item is a calendar entry, paste the client email here and click Match pasted text."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8"
                             ToolTip="Works without Outlook. Paste the request, then match."/>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
