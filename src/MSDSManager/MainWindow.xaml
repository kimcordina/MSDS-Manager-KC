<Window x:Class="MSDSManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MSDSManager"
        Title="MSDS Manager KC"
        Height="780"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="MSDS Manager KC"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Search, select and pack Safety Data Sheets from your OneDrive library."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LibraryPath}"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Find SDS from Outlook"
                            Command="{Binding FindRequestedFromOutlookCommand}"/>
                    <Button Content="Attach selection to Outlook"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AttachSelectionToOutlookCommand}"/>
                    <Button Content="Review dashboard"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenReviewDashboardCommand}"/>
                    <Button Content="Organise folders"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenFolderOrganiserCommand}"/>
                    <Button Content="Choose SDS Folder"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseLibraryCommand}"/>
                    <Button Content="Re-index Library"
                            Command="{Binding ReindexAsyncCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"/>
                <ProgressBar Grid.Column="1"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding IndexProgress}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Categories / packs -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Categories"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4,6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Main list -->
            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"/>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Favourites only"
                                      IsChecked="{Binding ShowFavouritesOnly}"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox Content="Recently used"
                                      IsChecked="{Binding ShowRecentOnly}"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                            <Button Content="Select all visible"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SelectAllVisibleCommand}"/>
                            <Button Content="Clear selection"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearSelectionCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Open PDFs" Command="{Binding OpenSelectedCommand}"/>
                            <Button Content="Attach to Outlook"
                                    Command="{Binding AttachSelectionToOutlookCommand}"/>
                            <Button Content="Copy to folder"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyToFolderCommand}"/>
                            <Button Content="Export zip"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportZipCommand}"/>
                            <Button Content="Reveal in Explorer"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RevealInExplorerCommand}"/>
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Documents}"
                              SelectedItem="{Binding SelectedDocument}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="36"/>
                            <DataGridTextColumn Header="Product"
                                                Binding="{Binding Document.ProductName}"
                                                Width="2*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Document.Category}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding Document.FileName}"
                                                Width="2*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Revision"
                                                Binding="{Binding Document.RevisionDateDisplay}"
                                                Width="110"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Version"
                                                Binding="{Binding Document.Version}"
                                                Width="80"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Document.StatusLabel}"
                                                   Foreground="{Binding Document.Status, Converter={StaticResource StatusBrush}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Detail / packs -->
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected SDS"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding SelectedDocument.Document.ProductName}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedDocument.Document.FileName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding SelectedDocument.Document.StatusReason}"
                                   Foreground="{StaticResource WarnBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button Content="Toggle favourite"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleFavouriteCommand}"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Mark verified"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding MarkSelectedVerifiedCommand}"/>
                            <Button Content="Request latest SDS"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RequestLatestForSelectedCommand}"/>
                            <Button Content="Export register"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ExportSdsRegisterCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="Aliases / customer names"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6"/>
                        <TextBlock Text="{Binding AliasListText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Add"
                                    Command="{Binding AddAliasCommand}"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding NewAlias, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>

                        <TextBlock Text="Text preview (from PDF)"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6"/>
                        <TextBox Text="{Binding SelectedDocument.Document.ExtractPreview}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFB"/>

                        <Separator Margin="0,18,0,12"/>

                        <TextBlock Text="Saved client packs"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Packs}"
                                 SelectedItem="{Binding SelectedPack}"
                                 Height="120"
                                 DisplayMemberPath="Name"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Load pack"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LoadPackCommand}"/>
                            <Button Content="Delete pack"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DeletePackCommand}"/>
                        </WrapPanel>

                        <TextBlock Text="Save current selection as pack"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Save"
                                    Command="{Binding SavePackCommand}"
                                    Margin="8,0,0,0"/>
                            <TextBox Text="{Binding NewPackName, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
