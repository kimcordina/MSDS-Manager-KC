<Window x:Class="MSDSManager.FolderOrganiseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organise SDS folders"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Suggest folder moves — you approve — then move"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Detects uncategorised files and likely wrong folders. Nested paths like Kitchen/Dishwashing are supported. Nothing moves until you confirm."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Scan library"
                            Command="{Binding ScanCommand}"/>
                    <Button Content="Select high confidence"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectHighConfidenceCommand}"/>
                    <Button Content="Clear"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearApprovalsCommand}"/>
                    <Button Content="Undo last move"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding UndoLastMoveAsyncCommand}"
                            IsEnabled="{Binding CanUndo}"
                            ToolTip="{Binding UndoHint}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Move approved files"
                        Command="{Binding ApplyApprovedAsyncCommand}"
                        Padding="16,10"/>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Text="{Binding SuggestionCount, StringFormat=Suggestions: {0}}"/>
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrushSubtle}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Move"
                                        Binding="{Binding Approve, UpdateSourceTrigger=PropertyChanged}"
                                        Width="50"/>
                <DataGridTextColumn Header="Issue"
                                    Binding="{Binding IssueLabel}"
                                    Width="110"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Product"
                                    Binding="{Binding ProductName}"
                                    Width="1.3*"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="File"
                                    Binding="{Binding FileName}"
                                    Width="1.2*"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Current folder"
                                    Binding="{Binding CurrentFolder}"
                                    Width="1*"
                                    IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Suggested folder" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding FolderChoices}"
                                      SelectedItem="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Confidence"
                                    Binding="{Binding ConfidenceLabel}"
                                    Width="90"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="Reason"
                                    Binding="{Binding Reason}"
                                    Width="1.4*"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
